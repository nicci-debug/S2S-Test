:root{--s2s-charcoal:#2a2d35;--s2s-red-primary:#e8312a;--s2s-red-hover:#c8231d;--s2s-white:#ffffff;--bs-primary:#e8312a;--bs-primary-rgb:232, 49, 42;--bs-body-font-family:"Roboto", sans-serif}body{color:#2a2d35;font-family:roboto,sans-serif}a{color:#e8312a}a:hover{color:#c8231d}.navbar-brand,.navbar-brand:hover,.navbar .nav-link{color:#2a2d35}.navbar .nav-link:hover{color:#c8231d}.btn-primary{--bs-btn-color:#ffffff;--bs-btn-bg:#e8312a;--bs-btn-border-color:#e8312a;--bs-btn-hover-color:#ffffff;--bs-btn-hover-bg:#c8231d;--bs-btn-hover-border-color:#c8231d;--bs-btn-active-color:#ffffff;--bs-btn-active-bg:#c8231d;--bs-btn-active-border-color:#c8231d;--bs-btn-disabled-color:#ffffff;--bs-btn-disabled-bg:#e8312a;--bs-btn-disabled-border-color:#e8312a}.site-footer{background-color:#2a2d35;color:#fff}.site-footer a,.site-footer a:hover{color:#fff}