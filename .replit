run = "hugo server --bind 0.0.0.0 --port 3000 --baseURL / --buildDrafts --disableFastRender"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Hugo Preview"

[[workflows.workflow]]
name = "Hugo Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "hugo server --bind 0.0.0.0 --port 3000 --baseURL / --buildDrafts --disableFastRender"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["hugo"]
